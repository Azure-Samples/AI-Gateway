// =============================================================================
// aigw-content-audit.kql
//
// Prompt / response audit query for the AIGatewayContent_CL custom table.
// Runs against the Log Analytics workspace provisioned by
// `main.bicep` (workspace name is configured via the
// `namePrefix` parameter — replace with your own value).
//
// Only principals with the granular RBAC role assignment provisioned by
// main.bicep (Log Analytics Data Reader on the workspace, with
// an ABAC condition restricting reads to AIGatewayContent_CL) can see
// results. Everyone else gets an empty result set.
// See: https://learn.microsoft.com/azure/azure-monitor/logs/granular-rbac-log-analytics
//
// Rows are written by the `emit-content-log` APIM policy fragment. Each
// turn produces two rows sharing a CorrelationId:
//     Direction=Prompt    (uploadText)
//     Direction=Response  (downloadText)
//
// Notes:
// - The Bedrock leg emits BOTH rows from the APIM outbound section (the
//   Lambda-supplied Purview verdict is only visible after the backend
//   call), so both rows carry the same PurviewBlocked / PurviewBlockReason.
// - The Foundry leg emits the Prompt row from inbound (after Gate 1) and
//   the Response row from outbound (after Gate 3), so each row carries
//   the verdict of the gate that inspected it.
// =============================================================================

// -----------------------------------------------------------------------------
// View 1 — chronological prompt/response feed, last 24h
// -----------------------------------------------------------------------------
AIGatewayContent_CL
| where TimeGenerated > ago(24h)
| project
    TimeGenerated,
    User,
    Backend,
    Model,
    Direction,
    CorrelationId,
    PurviewBlocked,
    PurviewBlockReason,
    InputTokens,
    OutputTokens,
    Content
| order by TimeGenerated desc

// -----------------------------------------------------------------------------
// View 2 — one row per turn (Prompt + Response joined by CorrelationId)
//          Uncomment to use.
// -----------------------------------------------------------------------------
// AIGatewayContent_CL
// | where TimeGenerated > ago(24h)
// | summarize
//     PromptTime   = minif(TimeGenerated, Direction == "Prompt"),
//     ResponseTime = minif(TimeGenerated, Direction == "Response"),
//     PromptText   = anyif(Content, Direction == "Prompt"),
//     ResponseText = anyif(Content, Direction == "Response"),
//     User         = any(User),
//     Backend      = any(Backend),
//     Model        = any(Model),
//     InputTokens  = maxif(InputTokens,  Direction == "Response"),
//     OutputTokens = maxif(OutputTokens, Direction == "Response"),
//     Blocked      = maxif(tostring(PurviewBlocked), Direction == "Response"),
//     BlockReason  = anyif(PurviewBlockReason, PurviewBlockReason != "none")
//   by CorrelationId
// | extend LatencyMs = datetime_diff('millisecond', ResponseTime, PromptTime)
// | order by PromptTime desc

// -----------------------------------------------------------------------------
// View 3 — blocked turns only (compliance / incident review)
//          Uncomment to use.
// -----------------------------------------------------------------------------
// AIGatewayContent_CL
// | where TimeGenerated > ago(7d)
// | where PurviewBlocked == true
// | project TimeGenerated, User, Backend, Model, Direction, PurviewBlockReason, Content, CorrelationId
// | order by TimeGenerated desc

// -----------------------------------------------------------------------------
// View 4 — join content to the cost trace for a single per-turn row that
//          combines "who / what they asked / what they got / what it cost".
//          Uncomment to use.
// -----------------------------------------------------------------------------
// let content =
//     AIGatewayContent_CL
//     | where TimeGenerated > ago(24h);
// let trace =
//     ApiManagementGatewayLogs
//     | where TimeGenerated > ago(24h)
//     | where ApiId in ("foundry-hrpolicy", "bedrock-expense")
//     | mv-expand t = TraceRecords
//     | where tostring(t.source) == "AIGateway"
//     | project
//         CorrelationId = tostring(t.metadata.CorrelationId),   // only present if you add it to the trace metadata
//         InputTokens   = tolong(coalesce(t.metadata.InputTokens,  "0")),
//         OutputTokens  = tolong(coalesce(t.metadata.OutputTokens, "0"));
// content
// | join kind=leftouter trace on CorrelationId
// | order by TimeGenerated desc
