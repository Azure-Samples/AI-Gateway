<policies>
    <inbound>
        <base />
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <set-query-parameter name="subscription-key" exists-action="delete" />
        <set-variable name="web-iq-auth-mode" value="@{
            if (string.Equals(&quot;{web-iq-auth-mode}&quot;, &quot;entra&quot;, System.StringComparison.OrdinalIgnoreCase))
            {
                return &quot;Entra ID&quot;;
            }

            return string.IsNullOrWhiteSpace(context.Request.Headers.GetValueOrDefault(&quot;x-apikey&quot;, &quot;&quot;)) ? &quot;Missing&quot; : &quot;API key&quot;;
        }" />
        <set-variable name="web-iq-mcp-tool" value="@{
            if (!string.Equals(context.Operation.Id, &quot;mcp-post&quot;, System.StringComparison.OrdinalIgnoreCase))
            {
                return &quot;N/A&quot;;
            }

            try
            {
                var requestBody = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
                if (!string.Equals((string)requestBody[&quot;method&quot;], &quot;tools/call&quot;, System.StringComparison.OrdinalIgnoreCase))
                {
                    return &quot;protocol&quot;;
                }

                var toolName = ((string)requestBody.SelectToken(&quot;params.name&quot;) ?? &quot;unknown&quot;).ToLowerInvariant();
                if (toolName == &quot;web&quot; || toolName == &quot;videos&quot; || toolName == &quot;browse&quot; || toolName == &quot;news&quot; || toolName == &quot;images&quot;)
                {
                    return toolName;
                }

                return &quot;unknown&quot;;
            }
            catch
            {
                return &quot;protocol&quot;;
            }
        }" />
        <emit-metric name="Web IQ Requests" value="1" namespace="web-iq">
            <dimension name="Subscription ID" />
            <dimension name="Operation ID" />
            <dimension name="Authentication" value="@((string)context.Variables[&quot;web-iq-auth-mode&quot;])" />
            <dimension name="MCP Tool" value="@((string)context.Variables[&quot;web-iq-mcp-tool&quot;])" />
        </emit-metric>
        <choose>
            <when condition="@(context.Operation.Id == &quot;browse-url&quot; || (string)context.Variables[&quot;web-iq-mcp-tool&quot;] == &quot;browse&quot;)">
                <emit-metric name="Web IQ Blocked Requests" value="1" namespace="web-iq">
                    <dimension name="Subscription ID" />
                    <dimension name="Operation ID" />
                    <dimension name="Authentication" value="@((string)context.Variables[&quot;web-iq-auth-mode&quot;])" />
                    <dimension name="MCP Tool" value="@((string)context.Variables[&quot;web-iq-mcp-tool&quot;])" />
                </emit-metric>
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-apim-request-id" exists-action="override">
                        <value>@(context.RequestId.ToString())</value>
                    </set-header>
                    <set-header name="x-content-safety-status" exists-action="override">
                        <value>not-applicable</value>
                    </set-header>
                    <set-body>{"errorCode":"BrowseOperationBlocked","errorCategory":"UserError","userMessage":"The Browse operation and MCP tool are disabled by the API Management policy."}</set-body>
                </return-response>
            </when>
        </choose>
        <choose>
            <when condition="@((string)context.Variables[&quot;web-iq-auth-mode&quot;] == &quot;Entra ID&quot;)">
                <set-header name="x-apikey" exists-action="delete" />
                <!-- Use APIM's system-assigned identity. Web IQ's scope is
                     https://api.microsoft.ai/.default; this policy takes the resource audience.
                     https://learn.microsoft.com/en-us/azure/api-management/authentication-managed-identity-policy#examples
                     https://learn.microsoft.com/en-us/web-iq/get-started/authentication -->
                <authentication-managed-identity resource="https://api.microsoft.ai" output-token-variable-name="web-iq-access-token" ignore-error="false" />
                <set-header name="Authorization" exists-action="override">
                    <value>@("Bearer " + (string)context.Variables["web-iq-access-token"])</value>
                </set-header>
            </when>
            <when condition="@((string)context.Variables[&quot;web-iq-auth-mode&quot;] == &quot;Missing&quot;)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-apim-request-id" exists-action="override">
                        <value>@(context.RequestId.ToString())</value>
                    </set-header>
                    <set-header name="x-content-safety-status" exists-action="override">
                        <value>not-applicable</value>
                    </set-header>
                    <set-body>{"errorCode":"WebIqAuthenticationRequired","errorCategory":"UserError","userMessage":"Provide a Web IQ x-apikey header. This gateway is configured for API-key authentication."}</set-body>
                </return-response>
            </when>
            <otherwise>
                <set-header name="Authorization" exists-action="delete" />
            </otherwise>
        </choose>
        <choose>
            <when condition="@(context.Operation.Id == &quot;mcp-get&quot;)">
                <!-- MCP permits 405 when the optional long-lived GET stream is unsupported.
                     POST responses are buffered and moderated before delivery. -->
                <return-response>
                    <set-status code="405" reason="Method Not Allowed" />
                    <set-header name="Allow" exists-action="override">
                        <value>POST, DELETE</value>
                    </set-header>
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-apim-request-id" exists-action="override">
                        <value>@(context.RequestId.ToString())</value>
                    </set-header>
                    <set-header name="x-content-safety-status" exists-action="override">
                        <value>not-applicable</value>
                    </set-header>
                    <set-body>{"errorCode":"McpEventStreamDisabled","userMessage":"Use MCP POST requests. This gateway buffers complete responses for text moderation."}</set-body>
                </return-response>
            </when>
        </choose>
        <set-header name="Accept-Encoding" exists-action="override">
            <value>identity</value>
        </set-header>
        <set-backend-service backend-id="web-iq-backend" />
    </inbound>
    <backend>
        <forward-request buffer-response="true" />
    </backend>
    <outbound>
        <base />
        <include-fragment fragment-id="web-iq-content-safety" />
        <emit-metric name="Web IQ Responses" value="1" namespace="web-iq">
            <dimension name="Subscription ID" />
            <dimension name="Operation ID" />
            <dimension name="Authentication" value="@((string)context.Variables[&quot;web-iq-auth-mode&quot;])" />
            <dimension name="MCP Tool" value="@((string)context.Variables[&quot;web-iq-mcp-tool&quot;])" />
            <dimension name="Status Code" value="@(context.Response.StatusCode.ToString())" />
        </emit-metric>
        <emit-metric name="Web IQ Latency" value="@(context.Elapsed.TotalMilliseconds)" namespace="web-iq">
            <dimension name="Subscription ID" />
            <dimension name="Operation ID" />
            <dimension name="Authentication" value="@((string)context.Variables[&quot;web-iq-auth-mode&quot;])" />
            <dimension name="MCP Tool" value="@((string)context.Variables[&quot;web-iq-mcp-tool&quot;])" />
            <dimension name="Status Code" value="@(context.Response.StatusCode.ToString())" />
        </emit-metric>
        <set-header name="x-apim-request-id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <emit-metric name="Web IQ Gateway Errors" value="1" namespace="web-iq">
            <dimension name="Subscription ID" />
            <dimension name="Operation ID" />
            <dimension name="MCP Tool" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;web-iq-mcp-tool&quot;, &quot;N/A&quot;))" />
        </emit-metric>
        <choose>
            <when condition="@(context.Variables.ContainsKey(&quot;web-iq-safety-start&quot;))">
                <emit-metric name="Web IQ Content Safety Responses" value="1" namespace="web-iq">
                    <dimension name="Subscription ID" />
                    <dimension name="Operation ID" />
                    <dimension name="Content Safety Status" value="error" />
                </emit-metric>
                <return-response>
                    <set-status code="502" reason="Bad Gateway" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="Content-Encoding" exists-action="delete" />
                    <set-header name="x-apim-request-id" exists-action="override">
                        <value>@(context.RequestId.ToString())</value>
                    </set-header>
                    <set-header name="x-content-safety-status" exists-action="override">
                        <value>error</value>
                    </set-header>
                    <set-header name="x-content-safety-scores" exists-action="delete" />
                    <set-body>{"errorCode":"ContentSafetyAnalysisFailed","userMessage":"The gateway could not complete response text moderation."}</set-body>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
